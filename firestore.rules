rules_version = '2';

// Reglas de Juego Mental: pégalas en la consola de Firebase › Firestore Database › Reglas › Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Progreso de cada persona: solo lo lee y escribe su dueño.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking: lo ve cualquiera con sesión; cada uno solo escribe su fila, con la forma y valores posibles.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && filaValida(request.resource.data);
    }

    // Duelos por turnos (games/duelos.js): lo ve cualquiera con sesión (para aceptar por enlace o al azar).
    match /duelos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && dueloNuevoValido(request.resource.data);
      allow update: if request.auth != null && (unirse() || anotar());
      allow delete: if request.auth != null && resource.data.anfitrion == request.auth.uid && resource.data.jugadores.size() == 1;
    }

    function dueloNuevoValido(d) {
      return d.keys().hasOnly(['anfitrion', 'jugadores', 'nombres', 'invitado', 'abierto', 'azar', 'juegos', 'dificultad', 'victoria', 'creado', 'caduca', 'resultados'])
        && d.anfitrion == request.auth.uid && d.jugadores == [request.auth.uid]
        && d.nombres is map && d.nombres.keys().hasOnly([request.auth.uid])
        && d.juegos is list && d.juegos.size() >= 1 && d.juegos.size() <= 5
        && d.victoria in ['juegos', 'puntos'] && d.dificultad in ['facil', 'normal', 'dificil']
        && d.abierto is bool && d.azar is bool && d.resultados == {}
        && d.caduca is int && d.caduca <= request.time.toMillis() + 172800000 + 600000;
    }

    // Entrar como segundo jugador: solo se añade uno mismo (y su apodo) y el duelo deja de estar abierto.
    function unirse() {
      let d = resource.data;
      let n = request.resource.data;
      return d.jugadores.size() == 1 && !(request.auth.uid in d.jugadores) && d.abierto == true
        && (d.invitado == null || d.invitado == request.auth.uid)
        && request.time.toMillis() < d.caduca
        && n.diff(d).affectedKeys().hasOnly(['jugadores', 'nombres', 'abierto'])
        && n.jugadores == d.jugadores.concat([request.auth.uid]) && n.abierto == false
        && n.nombres.diff(d.nombres).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Anotar una puntuación: solo la propia, solo un juego del duelo que aún no tenía (sin cambiar ni repetir).
    function anotar() {
      let d = resource.data;
      let n = request.resource.data;
      let antes = d.resultados.get(request.auth.uid, {});
      let despues = n.resultados.get(request.auth.uid, {});
      let cambio = despues.diff(antes);
      return request.auth.uid in d.jugadores
        && n.diff(d).affectedKeys().hasOnly(['resultados'])
        && n.resultados.diff(d.resultados).affectedKeys().hasOnly([request.auth.uid])
        && cambio.changedKeys().size() == 0 && cambio.removedKeys().size() == 0 && cambio.addedKeys().size() == 1
        && cambio.addedKeys().hasOnly(d.juegos);
    }

    function filaValida(f) {
      return f.keys().hasOnly(['apodo', 'estrellas', 'records', 'actualizado'])
        && f.apodo is string && f.apodo.size() >= 2 && f.apodo.size() <= 20
        && f.estrellas is int && f.estrellas >= 0 && f.estrellas <= 1000000
        && f.actualizado is int
        && f.records is map && recordsValidos(f.records);
    }

    // Mismos límites que LIMITES en games/sincro.js.
    function recordsValidos(r) {
      return r.keys().hasOnly(['calculo', 'mayor', 'distinto', 'series', 'sobra', 'balanza', 'atencion', 'topos', 'memoria', 'puzzle', 'rayo', 'parejas'])
        && enRango(r, 'calculo', 1, 300) && enRango(r, 'mayor', 1, 300) && enRango(r, 'distinto', 1, 300)
        && enRango(r, 'series', 1, 300) && enRango(r, 'sobra', 1, 300) && enRango(r, 'balanza', 1, 300)
        && enRango(r, 'atencion', 1, 300) && enRango(r, 'topos', 1, 300) && enRango(r, 'memoria', 1, 100)
        && enRango(r, 'puzzle', 1, 10000) && enRango(r, 'rayo', 80, 5000) && enRango(r, 'parejas', 6, 1000);
    }

    function enRango(r, id, min, max) {
      return !(id in r) || (r[id] is int && r[id] >= min && r[id] <= max);
    }
  }
}
