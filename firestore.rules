rules_version = '2';

// Reglas de Juego Mental: pégalas en la consola de Firebase › Firestore Database › Reglas › Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Progreso de cada persona: solo lo lee y escribe su dueño.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking: lo ve cualquiera con sesión; cada uno solo escribe su fila, con la forma y valores posibles.
    // Un admin puede borrar filas; quien está en `baneados` ya no puede escribir la suya.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid && !baneado() && filaValida(request.resource.data);
    }

    // Duelos por turnos (games/duelos.js): lo ve cualquiera con sesión (para aceptar por enlace o al azar).
    match /duelos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && dueloNuevoValido(request.resource.data);
      allow update: if request.auth != null && (unirse() || anotar());
      // Cualquiera de los dos (o el invitado) puede borrarlo; la app lo hace al borrar la cuenta.
      allow delete: if request.auth != null && (request.auth.uid in resource.data.jugadores || resource.data.invitado == request.auth.uid);
    }

    // Perfil público (apodo y código de amigo), para encontrar a alguien por su código.
    match /perfiles/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['apodo', 'codigo'])
        && request.resource.data.apodo is string && request.resource.data.apodo.size() >= 2 && request.resource.data.apodo.size() <= 20
        && request.resource.data.codigo is string && request.resource.data.codigo.size() == 7;
    }

    // Estado en línea: lo escribe su dueño; lo leen él y sus amigos (sonAmigos).
    match /estados/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || sonAmigos(uid, request.auth.uid));
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && estadoValido(request.resource.data);
    }

    // Reto en vivo: lo crea quien reta a un amigo; lo leen y borran los dos. La sala está en Realtime Database.
    match /invitacionesVivo/{sala} {
      allow read, delete: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if request.auth != null && invitacionValida(request.resource.data);
    }

    // Solicitudes de amistad: las ven y borran sus dos personas; solo quien la recibe puede aceptarla.
    match /solicitudes/{id} {
      allow read: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'para', 'nombreDe', 'nombrePara', 'estado', 'creada'])
        && request.resource.data.de == request.auth.uid && request.resource.data.para != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.para
        && request.resource.data.estado == 'pendiente'
        && nombre(request.resource.data.nombreDe) && nombre(request.resource.data.nombrePara) && request.resource.data.creada is int;
      allow update: if request.auth != null && resource.data.para == request.auth.uid && resource.data.estado == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) && request.resource.data.estado == 'aceptada';
    }

    // Liga semanal: la ve cualquiera con sesión; cada uno escribe solo su fila de cada semana.
    match /liga/{semana}/jugadores/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid && !baneado()
        && request.resource.data.keys().hasOnly(['apodo', 'puntos', 'actualizado'])
        && request.resource.data.apodo is string && request.resource.data.apodo.size() >= 2 && request.resource.data.apodo.size() <= 20
        && request.resource.data.puntos is int && request.resource.data.puntos >= 0 && request.resource.data.puntos <= 5000
        && request.resource.data.actualizado is int;
    }

    // ✍️ Preguntas de los jugadores: cada uno propone y ve las suyas; solo un admin las revisa.
    // Un admin es quien tiene un documento en `admins` (se crea a mano en la consola; desde la app no se puede escribir).
    match /propuestas/{id} {
      allow read, delete: if request.auth != null && (resource.data.de == request.auth.uid || esAdmin());
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['de', 'apodo', 'c', 'd', 'p', 'o', 'estado', 'creada'])
        && request.resource.data.de == request.auth.uid && request.resource.data.estado == 'pendiente'
        && request.resource.data.apodo is string && request.resource.data.apodo.size() <= 20
        && request.resource.data.creada is int && preguntaValida(request.resource.data);
      allow update: if esAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado in ['aprobada', 'rechazada'];
    }

    // Preguntas aprobadas: las lee cualquiera (se suman al banco); solo un admin las escribe.
    match /preguntas/{id} {
      allow read: if true;
      allow delete: if esAdmin();
      allow create, update: if esAdmin() && request.resource.data.keys().hasOnly(['c', 'd', 'p', 'o']) && preguntaValida(request.resource.data);
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Expulsados del ranking y la liga: solo un admin los escribe (y los perdona borrándolos).
    match /baneados/{uid} {
      allow read: if esAdmin();
      allow create, update: if esAdmin() && request.resource.data.keys().hasOnly(['apodo', 'cuando']);
      allow delete: if esAdmin();
    }

    function baneado() {
      return exists(/databases/$(database)/documents/baneados/$(request.auth.uid));
    }

    function esAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function opcionValida(o) {
      return o is string && o.size() >= 1 && o.size() <= 26;
    }

    function preguntaValida(q) {
      return q.c in ['geo', 'historia', 'ciencia', 'ocio', 'comida', 'animales'] && q.d in [1, 2, 3]
        && q.p is string && q.p.size() >= 10 && q.p.size() <= 110
        && q.o is list && q.o.size() == 4
        && opcionValida(q.o[0]) && opcionValida(q.o[1]) && opcionValida(q.o[2]) && opcionValida(q.o[3]);
    }

    function dueloNuevoValido(d) {
      return d.keys().hasOnly(['anfitrion', 'jugadores', 'nombres', 'invitado', 'abierto', 'azar', 'juegos', 'dificultad', 'victoria', 'creado', 'caduca', 'resultados', 'semilla'])
        && d.anfitrion == request.auth.uid && d.jugadores == [request.auth.uid]
        && d.nombres is map && d.nombres.keys().hasOnly([request.auth.uid]) && nombre(d.nombres[request.auth.uid])
        && d.juegos is list && d.juegos.size() >= 1 && d.juegos.size() <= 5 && topes().keys().hasAll(d.juegos)
        && (d.invitado == null || (d.invitado is string && sonAmigos(request.auth.uid, d.invitado)))
        && d.creado is int
        && d.victoria in ['juegos', 'puntos'] && d.dificultad in ['facil', 'normal', 'dificil']
        && d.abierto is bool && d.azar is bool && d.resultados == {}
        && (!('semilla' in d) || d.semilla is int)
        && d.caduca is int && d.caduca <= request.time.toMillis() + 172800000 + 600000;
    }

    // Entrar como segundo jugador: solo se añade uno mismo (y su apodo) y el duelo deja de estar abierto.
    function unirse() {
      let d = resource.data;
      let n = request.resource.data;
      return d.jugadores.size() == 1 && !(request.auth.uid in d.jugadores) && d.abierto == true
        && (d.invitado == null || d.invitado == request.auth.uid)
        && request.time.toMillis() < d.caduca
        && n.diff(d).affectedKeys().hasOnly(['jugadores', 'nombres', 'abierto'])
        && n.jugadores == d.jugadores.concat([request.auth.uid]) && n.abierto == false
        && n.nombres.diff(d.nombres).affectedKeys().hasOnly([request.auth.uid]) && nombre(n.nombres[request.auth.uid]);
    }

    // Anotar una puntuación: solo la propia, solo un juego del duelo que aún no tenía (sin cambiar ni repetir).
    function anotar() {
      let d = resource.data;
      let n = request.resource.data;
      let antes = d.resultados.get(request.auth.uid, {});
      let despues = n.resultados.get(request.auth.uid, {});
      let cambio = despues.diff(antes);
      return request.auth.uid in d.jugadores
        && n.diff(d).affectedKeys().hasOnly(['resultados'])
        && n.resultados.diff(d.resultados).affectedKeys().hasOnly([request.auth.uid])
        && cambio.changedKeys().size() == 0 && cambio.removedKeys().size() == 0 && cambio.addedKeys().size() == 1
        && cambio.addedKeys().hasOnly(d.juegos)
        && puntoValido(despues.keys().removeAll(antes.keys())[0], despues[despues.keys().removeAll(antes.keys())[0]]);
    }

    // Puntuación posible de cada juego en un duelo (0 = no terminó). Un juego que no está aquí no puede ir en un duelo.
    function topes() {
      return { 'calculo': 1000, 'mayor': 1000, 'menos': 1000, 'verdad': 1000, 'cuenta': 1000, 'anagrama': 1000, 'distinto': 1000,
        'series': 1000, 'sobra': 1000, 'balanza': 1000, 'atencion': 1000, 'topos': 1000, 'memoria': 1000, 'trivia': 1000,
        'puzzle': 100000, 'rayo': 100000, 'parejas': 100000,
        'serpiente': 100000, 'saltar': 100000, 'autos': 100000, 'ladrillos': 100000, 'bloques': 10000000,
        'palabra': 10000, 'ahorcado': 100000, 'sopa': 100000, 'escalera': 10000, 'charadas': 1000, 'granescalera': 1000000 };
    }

    function puntoValido(id, v) {
      return v is number && v >= 0 && v <= topes()[id];
    }

    function nombre(x) {
      return x is string && x.size() >= 1 && x.size() <= 20;
    }

    function estadoValido(d) {
      return d.keys().hasOnly(['estado', 'cuando']) && d.keys().hasAll(['estado', 'cuando'])
        && d.estado in ['conectado', 'jugando', 'ausente', 'desconectado']
        && d.cuando == request.time;
    }

    function invitacionValida(d) {
      return d.keys().hasOnly(['de', 'para', 'nombre', 'juegos', 'dificultad', 'cuando'])
        && d.de == request.auth.uid && d.para is string && nombre(d.nombre)
        && d.juegos is list && d.juegos.size() >= 1 && d.juegos.size() <= 5
        && d.dificultad is string && d.dificultad.size() <= 20
        && d.cuando == request.time
        && sonAmigos(d.de, d.para);
    }

    // Amigos: hay una solicitud aceptada entre los dos (en cualquier sentido).
    function sonAmigos(a, b) {
      let ida = /databases/$(database)/documents/solicitudes/$(a + '_' + b);
      let vuelta = /databases/$(database)/documents/solicitudes/$(b + '_' + a);
      return (exists(ida) && get(ida).data.estado == 'aceptada') || (exists(vuelta) && get(vuelta).data.estado == 'aceptada');
    }

    function filaValida(f) {
      return f.keys().hasOnly(['apodo', 'estrellas', 'records', 'actualizado'])
        && f.apodo is string && f.apodo.size() >= 2 && f.apodo.size() <= 20
        && f.estrellas is int && f.estrellas >= 0 && f.estrellas <= 1000000
        && f.actualizado is int
        && f.records is map && recordsValidos(f.records);
    }

    // Mismos límites que LIMITES en games/sincro.js.
    function recordsValidos(r) {
      return r.keys().hasOnly(['calculo', 'mayor', 'menos', 'verdad', 'cuenta', 'anagrama', 'distinto', 'series', 'sobra', 'balanza', 'atencion', 'topos', 'memoria', 'puzzle', 'rayo', 'parejas', 'serpiente', 'saltar', 'autos', 'ladrillos', 'bloques', 'palabra', 'ahorcado', 'sopa', 'escalera', 'granescalera'])
        && enRango(r, 'calculo', 1, 300) && enRango(r, 'mayor', 1, 300) && enRango(r, 'menos', 1, 300) && enRango(r, 'verdad', 1, 300) && enRango(r, 'cuenta', 1, 300) && enRango(r, 'anagrama', 1, 300) && enRango(r, 'distinto', 1, 300)
        && enRango(r, 'series', 1, 300) && enRango(r, 'sobra', 1, 300) && enRango(r, 'balanza', 1, 300)
        && enRango(r, 'atencion', 1, 300) && enRango(r, 'topos', 1, 300) && enRango(r, 'memoria', 1, 100)
        && enRango(r, 'puzzle', 1, 10000) && enRango(r, 'rayo', 80, 5000) && enRango(r, 'parejas', 6, 1000)
        && enRango(r, 'serpiente', 1, 100000) && enRango(r, 'saltar', 1, 100000) && enRango(r, 'autos', 1, 100000) && enRango(r, 'ladrillos', 1, 100000) && enRango(r, 'bloques', 1, 10000000)
        && enRango(r, 'palabra', 1, 10000) && enRango(r, 'ahorcado', 1, 100000) && enRango(r, 'sopa', 1, 100000)
        && enRango(r, 'escalera', 1, 10000) && enRango(r, 'granescalera', 1, 1000000);
    }

    function enRango(r, id, min, max) {
      return !(id in r) || (r[id] is int && r[id] >= min && r[id] <= max);
    }
  }
}
